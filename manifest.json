{
  "manifest_version": 3,
  "name": "Jev Fast",
  "version": "1.1.0",
  "description": "High-speed page automation powered by Jev via BeatAPI or TypeSafe. Bounded Choice and Noul decisions over the live DOM — no generated code.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "https://api.beatapi.io/*",
    "https://api.typesafe.ai/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jev Fast",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116"
}
